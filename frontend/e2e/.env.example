# Copy to e2e/.env (gitignored). Required locally, and the only source of E2E_*
# variables (the shell's are ignored). Every value is validated before the run
# starts; one error lists everything that needs fixing.
#
# The accounts below are the throwaway ones .github/scripts/seed_e2e_users.py
# creates on a local dev backend, so this works as-is there. For any other
# backend, replace them with accounts that already exist on it.

# An admin account: every gated control must be present.
E2E_ADMIN_USERNAME=e2e_admin
E2E_ADMIN_PASSWORD=e2e-Passw0rd!

# A non-admin account in the "Viewer (legacy)" group: every ROM write control
# must be absent.
E2E_VIEWER_USERNAME=e2e_viewer
E2E_VIEWER_PASSWORD=e2e-Passw0rd!

# The backend to test. Set exactly one of these two.
#
# A local backend: its port, the same value it binds (DEV_PORT in the repo's
# .env, 5000 by default).
E2E_DEV_PORT=5000
# A remote backend: its URL. Comment out E2E_DEV_PORT when you set this.
# E2E_DEV_PROXY_TARGET=https://romm.example.com

# Optional: parallel workers (default 2 locally).
# E2E_WORKERS=2
